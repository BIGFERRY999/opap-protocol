# Database Configuration (PostgreSQL in container or local, or sqlite:///./opap.db for standalone test)
DATABASE_URL=postgresql+psycopg://opap:opap-local-only@db:5432/opap
POSTGRES_PASSWORD=opap-local-only

# API Security & Endpoints
OPAP_API_KEY=dev-change-me
PUBLIC_BASE_URL=http://localhost:8000
SQL_ECHO=false

# Signer Provider Configuration
# Supported providers: 'env', 'file', 'aws_kms', 'gcp_kms', 'pkcs11', 'mock'
OPAP_SIGNER_PROVIDER=env

# Provider 1: 'env' (In-memory development Ed25519 private key hex)
OPAP_SIGNING_PRIVATE_KEY_HEX=088d8ece383a02b1c9f9ee0add0753ed90a9bd0fd5a52394deb318ad018b3af2

# Provider 2: 'file' (Path to raw 32-byte binary, hex, or PEM key file)
# OPAP_SIGNING_KEY_PATH=/secrets/opap-ed25519.pem

# Provider 3: 'aws_kms' (AWS KMS asymmetric signing key)
# OPAP_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/your-key-uuid
# OPAP_KMS_REGION=us-east-1
# OPAP_KMS_MOCK=false

# Provider 4: 'gcp_kms' (Google Cloud KMS asymmetric signing key)
# OPAP_GCP_KMS_KEY_NAME=projects/MY_PROJECT/locations/global/keyRings/MY_RING/cryptoKeys/MY_KEY/cryptoKeyVersions/1

# Provider 5: 'pkcs11' (Hardware Security Module)
# OPAP_PKCS11_LIB_PATH=/usr/lib/softhsm/libsofthsm2.so
# OPAP_PKCS11_SLOT_ID=0
# OPAP_PKCS11_KEY_LABEL=opap-ed25519
